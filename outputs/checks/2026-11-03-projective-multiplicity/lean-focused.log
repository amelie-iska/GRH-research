GRHResearch.ThetaProjectiveMultiplicity.six_path_blocks_det.{u_1, u_2} {R : Type u_1} [CommRing R] {ι : Type u_2}
  [Fintype ι] [DecidableEq ι] (M : Matrix (Fin 6 × ι) (Fin 6 × ι) R) (A : Matrix ι ι R)
  (ht : M.BlockTriangular Prod.fst) (hd : ∀ (k : Fin 6) (i j : ι), M (k, i) (k, j) = A i j) : M.det = A.det ^ 6
GRHResearch.ThetaProjectiveMultiplicity.six_path_blocks_local_det.{u_1, u_2} {R : Type u_1} [CommRing R] {ι : Type u_2}
  [Fintype ι] [DecidableEq ι] (M : Matrix (Fin 6 × ι) (Fin 6 × ι) R) (A : Matrix ι ι R)
  (ht : M.BlockTriangular Prod.fst) (hd : ∀ (k : Fin 6) (i j : ι), M (k, i) (k, j) = A i j) (t : R) :
  (1 - t • M).det = (1 - t • A).det ^ 6
GRHResearch.ThetaProjectiveMultiplicity.power_series_det_specialization.{u_1, u_2} {R : Type u_1} [CommRing R]
  {ι : Type u_2} [Fintype ι] [DecidableEq ι] (M : Matrix ι ι (PowerSeries R)) (t : R) :
  PowerSeries.constantCoeff (1 - PowerSeries.C t • M).det = (1 - t • M.map ⇑PowerSeries.constantCoeff).det
GRHResearch.ThetaProjectiveMultiplicity.quadratic_not_ratio_sixth (P A B : Polynomial ℚ) (hp : P.natDegree = 2)
  (hb : B ≠ 0) : P * B ^ 6 ≠ A ^ 6
