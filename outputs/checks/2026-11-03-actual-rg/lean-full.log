  ∑ x, χ x * star (ψ x) = if χ = ψ then ↑(Fintype.card F) - 1 else 0
GRHResearch.ShortRowGram.finite_gram_expansion.{u_2, u_3} {ρ : Type u_2} {ι : Type u_3} (rows : Finset ρ)
  (columns : Finset ι) (c : ι → ℂ) (kernel : ρ → ι → ℂ) :
  ∑ k ∈ rows, ‖∑ n ∈ columns, c n * kernel k n‖ ^ 2 =
    (∑ n ∈ columns, ∑ m ∈ columns, c n * star (c m) * ∑ k ∈ rows, kernel k n * star (kernel k m)).re
