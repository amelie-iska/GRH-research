GRHResearch.Hodge.boundary_relative_product.{u_1} {R : Type u_1} [Ring R] (P M N : R) (hMP : M * P = P * M)
  (hN : (1 - M) * N = 1) : (1 - M) * (P + (1 - P) * N) = 1 - P * M
GRHResearch.Hodge.odd_dirac_square.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [DecidableEq m] [Fintype n]
  [DecidableEq n] (B : Matrix n m ℂ) : fromBlocks 0 Bᴴ B 0 * fromBlocks 0 Bᴴ B 0 = fromBlocks (Bᴴ * B) 0 0 (B * Bᴴ)
GRHResearch.Hodge.gram_partners_positive.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] (B : Matrix n m ℂ) : (Bᴴ * B).PosSemidef ∧ (B * Bᴴ).PosSemidef
GRHResearch.Hodge.shifted_matrix_factor.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (M : Matrix ι ι ℂ) (μ : ℂ)
  (hμ : μ ≠ 0) : μ • 1 + M = μ • (1 + μ⁻¹ • M)
GRHResearch.Hodge.identity_metric_positive (r : ℝ) (hr : 0 < r) : (↑r • 1).PosDef
GRHResearch.Hodge.normalized_gram_determinants.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] (B : Matrix n m ℂ) (z : ℂ) : (1 + z • (Bᴴ * B)).det = (1 + z • (B * Bᴴ)).det
GRHResearch.Hodge.shifted_gram_determinants.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] (B : Matrix n m ℂ) (μ : ℂ) (hμ : μ ≠ 0) :
  (μ • 1 + Bᴴ * B).det * μ ^ Fintype.card n = (μ • 1 + B * Bᴴ).det * μ ^ Fintype.card m
GRHResearch.Hodge.normalized_gram_superdet.{u_1, u_2} {m : Type u_1} {n : Type u_2} [Fintype m] [DecidableEq m]
  [Fintype n] [DecidableEq n] (B : Matrix n m ℂ) (z : ℂ) (h : (1 + z • (B * Bᴴ)).det ≠ 0) :
  (1 + z • (Bᴴ * B)).det / (1 + z • (B * Bᴴ)).det = 1
GRHResearch.Hodge.identity_weighted_adjoint (r : ℝ) : 1ᴴ * ↑r • 1 = ↑r • 1
GRHResearch.Hodge.identity_metric_laplacian_det (r : ℝ) (z : ℂ) : (↑r • 1 - z • 1).det = ↑r - z
GRHResearch.Hodge.identity_metric_moves_zero : (1 • 1 - 1 • 1).det = 0 ∧ (4 • 1 - 1 • 1).det ≠ 0
