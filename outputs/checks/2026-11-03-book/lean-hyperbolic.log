GRHResearch.HyperbolicCoordinates.disk_to_hyperboloid (x y : ℝ) (h : 1 - x ^ 2 - y ^ 2 ≠ 0) :
  ((1 + x ^ 2 + y ^ 2) / (1 - x ^ 2 - y ^ 2)) ^ 2 - (2 * x / (1 - x ^ 2 - y ^ 2)) ^ 2 -
      (2 * y / (1 - x ^ 2 - y ^ 2)) ^ 2 =
    1
GRHResearch.HyperbolicCoordinates.inverse_disk_defect (X Y T : ℝ) (hT : T + 1 ≠ 0) (h : T ^ 2 - X ^ 2 - Y ^ 2 = 1) :
  1 - (X / (T + 1)) ^ 2 - (Y / (T + 1)) ^ 2 = 2 / (T + 1)
GRHResearch.HyperbolicCoordinates.rotation_four_norm (a b c d p q : ℝ) (h : p ^ 2 + q ^ 2 = 1) :
  (p * a - q * c) ^ 2 + b ^ 2 + (q * a + p * c) ^ 2 + d ^ 2 = a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2
'GRHResearch.HyperbolicCoordinates.disk_to_hyperboloid' depends on axioms: [propext, Classical.choice, Quot.sound]
'GRHResearch.HyperbolicCoordinates.inverse_disk_defect' depends on axioms: [propext, Classical.choice, Quot.sound]
'GRHResearch.HyperbolicCoordinates.rotation_four_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
