GRHResearch.Analytic.central_normalization_identity (σ a h lx ly ell g d R δ z e εc εd : ℝ) (hh : h = 1 - lx + ell) :
  lx * (1 / 2 - z) + a + z - 1 - a * ly - d * z + (16 - 6 * ly) * e +
        (d * (R + δ / 2 + εc) + ell * (z - 1 / 2) + g + εc + d * εd) -
      (σ + lx / 2 - 1 + h / 6) =
    GRHResearch.Analytic.centralExponent σ a h ly ell g d R δ z + (16 - 6 * ly) * e + (1 + d) * εc + d * εd
'GRHResearch.Analytic.central_normalization_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.central_reference_shift (σ β a h ly ell g d R δ z : ℝ) :
  GRHResearch.Analytic.centralExponent σ a h ly ell g d R δ z - (β - σ) =
    GRHResearch.Analytic.centralExponent β a h ly ell g d R δ z
'GRHResearch.Analytic.central_reference_shift' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.central_perturbation_identities (t δ q R d : ℝ) :
  GRHResearch.Analytic.centralExponent (7 / 8 - t / 4) ((1 + δ) / 2) (13 / 16 + 3 * t / 2) (23 / 48 - t / 2) (1 / 6 + t)
          (q * (1 / 6 + t)) d R δ (17 / 50) -
        GRHResearch.Analytic.centralExponent (7 / 8) ((1 + δ) / 2) (13 / 16) (23 / 48) (1 / 6) (q / 6) d R δ (17 / 50) =
      t * (13 / 50 + δ / 4 + q) ∧
    GRHResearch.Analytic.centralExponent (7 / 8 - t / 4) ((1 + δ) / 2) (13 / 16 + 3 * t / 2) (23 / 48 - t / 2)
          (1 / 6 + t) (q * (1 / 6 + t)) (13 / 16 + 3 * t / 2) R δ (17 / 50) -
        GRHResearch.Analytic.centralExponent (7 / 8) ((1 + δ) / 2) (13 / 16) (23 / 48) (1 / 6) (q / 6) (13 / 16) R δ
          (17 / 50) =
      t * (-1 / 4 + δ + q + 3 * R / 2)
'GRHResearch.Analytic.central_perturbation_identities' depends on axioms: [propext, Classical.choice, Quot.sound]
