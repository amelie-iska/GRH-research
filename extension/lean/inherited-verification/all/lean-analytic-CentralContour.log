GRHResearch.Analytic.simultaneous_ramified_power_credit.{u_1} {ι : Type u_1} (F : Finset ι) (Q : ι → ℝ) (j : ι → ℕ)
  {w : ℝ} (hw : w ≤ 1 / 2) (hQ : ∀ i ∈ F, 1 ≤ Q i) (hj : ∀ i ∈ F, 2 ≤ j i) :
  ∏ i ∈ F, Q i ^ (-w - (↑(j i) - 1) * (1 / 2 - w)) ≤ ∏ i ∈ F, Q i ^ (-(1 / 2))
