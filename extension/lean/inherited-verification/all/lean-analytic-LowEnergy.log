GRHResearch.Analytic.hybrid_minimum_dichotomy {v z : ℝ} (hv : 0 ≤ v) :
  GRHResearch.Analytic.hybridMinimum v z = z ∨ v / 2 ≤ GRHResearch.Analytic.hybridMinimum v z
'GRHResearch.Analytic.hybrid_minimum_dichotomy' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.kernel_quarter_charge (T y : ℝ) : T / 4 ≤ y / 4 + max 0 (T - y) / 2
'GRHResearch.Analytic.kernel_quarter_charge' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.reflected_energy_upper {O H A S N B z ell θ v lb e M ε τ : ℝ} (hε : 0 ≤ ε) (hτ : 0 ≤ τ)
  (hO : -ε ≤ O) (hH : H ≤ M - O + ε) (hA : 0 ≤ A) (hAwidth : 2 * A ≤ O + ε) (hS : 0 ≤ S) (hN : 0 ≤ N) (hNA : N ≤ A)
  (hB : 0 ≤ B) (hz : z ≤ ell) (hsum : M + ell ≤ 1) (hv : 0 ≤ v) (hlb : 0 ≤ lb) (he : -ε ≤ e)
  (hret : v + 3 * lb + e ≤ GRHResearch.Analytic.dualLength H A z ell θ N B + τ) :
  GRHResearch.Analytic.reflectedEnergy O H A S N B z ell θ v lb e ≤
    M + max 0 ((1 + 3 * ell - 2 * M) / 4) + 6 * ε + 2 * |θ| + τ
'GRHResearch.Analytic.reflected_energy_upper' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.perturbed_rescaling_identities (t d : ℝ) :
  5 / 6 - t - 2 * d + (1 / 6 + t - d) - 1 = -3 * d ∧
    1 + 3 * (1 / 6 + t - d) - 2 * (5 / 6 - t - 2 * d) = -1 / 6 + 5 * t + d ∧
      23 / 48 - t / 2 - (17 / 48 - t / 2) = 1 / 8 ∧
        (17 / 48 - t / 2) / 2 - 1 + (13 / 16 + 3 * t / 2) / 6 = -11 / 16 ∧
          (17 / 48 - t / 2) / 2 + 1 / 8 / 12 = 3 / 16 - t / 4
'GRHResearch.Analytic.perturbed_rescaling_identities' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.perturbed_scale_margins {t d : ℝ} (ht : t ≤ 1 / 30) (hd : d ≤ 1 / 6 + t) :
  11 / 80 ≤ 17 / 48 - t / 2 - d ∧
    21 / 80 ≤ 23 / 48 - t / 2 - d ∧ 2 / 5 ≤ 5 / 6 - t - 2 * d ∧ 1 / 30 ≤ 23 / 48 - t / 2 - d - 11 * (1 / 8) / 6
'GRHResearch.Analytic.perturbed_scale_margins' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.perturbed_rescaling_loss {t d : ℝ} (ht : t ≤ 1 / 30) (hd : 0 ≤ d) :
  -d + max 0 ((-1 / 6 + 5 * t + d) / 4) / 2 ≤ -7 * d / 8
'GRHResearch.Analytic.perturbed_rescaling_loss' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.perturbed_rescaling_power {Z t d : ℝ} (hZ : 1 ≤ Z) (ht : t ≤ 1 / 30) (hd : 0 ≤ d) :
  Z ^ (-d + max 0 ((-1 / 6 + 5 * t + d) / 4) / 2) ≤ 1
'GRHResearch.Analytic.perturbed_rescaling_power' depends on axioms: [propext, Classical.choice, Quot.sound]
