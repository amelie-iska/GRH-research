GRHResearch.Analytic.finite_product_relative_error.{u_1} {ι : Type u_1} [DecidableEq ι] (P : Finset ι) (ρ : ι → ℂ)
  {δ : ℝ} (hδ1 : δ ≤ 1) (hρ : ∀ i ∈ P, ‖ρ i‖ ≤ δ) : ‖∏ i ∈ P, (1 + ρ i) - 1‖ ≤ (2 ^ P.card - 1) * δ
