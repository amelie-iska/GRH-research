  (hsum : Summable fun i => ‖f i‖) : ∏' (i : ι), (1 + f i) ≠ 0
'GRHResearch.Analytic.correction_tprod_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.correction_tprod_error.{u_1} {ι : Type u_1} (f : ι → ℂ) (hsum : Summable fun i => ‖f i‖) :
  ‖∏' (i : ι), (1 + f i) - 1‖ ≤ Real.exp (∑' (i : ι), ‖f i‖) - 1
'GRHResearch.Analytic.correction_tprod_error' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.shifted_zero_transport {A L H : ℂ → ℂ} {ρ : ℂ} (hρ : 1 / 2 ≤ ρ.re) (hzero : L ρ = 0)
  (hfactor : ∀ (s : ℂ), 1 / 2 < s.re → H s = A s * L (6 * s - 3)) : H ((ρ + 3) / 6) = 0 ∧ 7 / 12 ≤ ((ρ + 3) / 6).re
'GRHResearch.Analytic.shifted_zero_transport' depends on axioms: [propext, Classical.choice, Quot.sound]
