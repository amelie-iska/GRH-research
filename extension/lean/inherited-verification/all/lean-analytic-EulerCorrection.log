GRHResearch.Analytic.good_residual_identity (q v w d r : ℂ) (hv : 1 - v ≠ 0) (hr : 1 - r ≠ 0) :
  GRHResearch.Analytic.goodPStar q v w d r + d =
    (r * ((1 - q⁻¹) / (1 - v) + w - d) - d * w * (q - 1) * v / (1 - v)) / (1 - r)
'GRHResearch.Analytic.good_residual_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.principal_correction_from_local (v d r : ℂ) (hv : 1 - v ≠ 0) (hd : 1 - d ≠ 0) (hr : 1 - r ≠ 0) :
  (1 / (1 - v) + v / (1 - v) + ((r * (1 - v) - d * v * (1 - v)) / (1 - v) - d + v * r) / (1 - r)) * (1 - v) ^ 2 /
      (1 - d) =
    GRHResearch.Analytic.principalCorrection v d r
'GRHResearch.Analytic.principal_correction_from_local' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.principal_remainder_defect (v d r : ℂ) (hd : 1 - d ≠ 0) :
  GRHResearch.Analytic.principalRemainder v d r - 1 = -v ^ 2 + (1 - v ^ 2) * v * (d - r) / (1 - d)
'GRHResearch.Analytic.principal_remainder_defect' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.principal_euler_factorization (v d r : ℂ) (hd : 1 - d ≠ 0) (hr : 1 - r ≠ 0) :
  GRHResearch.Analytic.principalCorrection v d r = GRHResearch.Analytic.principalRemainder v d r / (1 - r)
'GRHResearch.Analytic.principal_euler_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
GRHResearch.Analytic.principal_correction_ne_zero {v : ℝ} {d r : ℂ} (hv0 : 0 < v) (hv1 : v < 1) (hd : ‖d‖ < 1)
  (hr : ‖r‖ < 1) : GRHResearch.Analytic.principalCorrection (↑v) d r ≠ 0
'GRHResearch.Analytic.principal_correction_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
